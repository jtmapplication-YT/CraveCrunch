# Copy to apps/web/.env.local. Server-only keys for the Next.js routes.

# Supabase: the URL and publishable key live in packages/core/src/supabase.ts (public by design).
# The service_role / secret key is never needed in either app.

# Server-only keys. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

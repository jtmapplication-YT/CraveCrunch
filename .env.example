# Copy to .env.local in apps/web (and set the EXPO_PUBLIC_ ones in apps/mobile/.env.local).

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
